{
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python tests/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git worktree*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --merged*)",
      "Bash(git branch --no-merged*)",
      "Bash(git merge*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh api repos/Gethe/wow-ui-source*)",
      "Bash(gh api repos/Ketho/BlizzardInterfaceResources*)",
      "WebFetch(domain:wago.tools)",
      "PowerShell(python tools/*)",
      "PowerShell(python tests/*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git worktree*)",
      "PowerShell(git branch)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -r)",
      "PowerShell(git branch -v)",
      "PowerShell(git branch -vv)",
      "PowerShell(git branch --list*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --merged*)",
      "PowerShell(git branch --no-merged*)",
      "PowerShell(git merge*)"
    ],
    "ask": [
      "Bash(python tools/release.py*)",
      "Bash(python tests/setversion.py*)",
      "PowerShell(python tools/release.py*)",
      "PowerShell(python tests/setversion.py*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch -df*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(gh secret*)",
      "Bash(gh api * -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api * --field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api * --input*)",
      "Bash(gh api * -iX*)",
      "Bash(gh api * -if*)",
      "Bash(gh api * -iF*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch * -D*)",
      "PowerShell(git branch -f*)",
      "PowerShell(git branch * -f*)",
      "PowerShell(git branch -df*)",
      "PowerShell(git branch --force*)",
      "PowerShell(git branch * --force*)",
      "PowerShell(git worktree remove --force*)",
      "PowerShell(git worktree remove -f*)",
      "PowerShell(gh secret*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'tools','lint.py');sys.exit(subprocess.call([sys.executable,p,'--quick']) if os.path.isfile(p) else 0)\"; exit $LASTEXITCODE",
            "timeout": 20,
            "statusMessage": "lint"
          }
        ]
      }
    ]
  }
}
