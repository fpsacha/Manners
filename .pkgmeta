package-as: Manners

enable-nolib-creation: no

externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/ace3/trunk/LibStub
  Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceEvent-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceEvent-3.0
  Libs/AceTimer-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceTimer-3.0
  Libs/AceConsole-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceConsole-3.0
  Libs/AceDB-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceDBOptions-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceDBOptions-3.0
  Libs/AceGUI-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceGUI-3.0
  Libs/AceConfig-3.0:
    url: https://repos.curseforge.com/wow/ace3/trunk/AceConfig-3.0
  Libs/LibSharedMedia-3.0:
    url: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  # Not on CurseForge's SVN -- that path 404s. This is its canonical home, and
  # the library has been finished since 2015.
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  # The only thing on any of these clients that answers "how far away is this
  # player" in steps rather than yes or no, which is what a proximity setting
  # needs. Fetched with the rest, and optional at run time: Core.lua asks
  # LibStub for it with the silent flag and drops to CheckInteractDistance, and
  # then to offering everybody in casting range, if it is not there.
  Libs/LibRangeCheck-3.0:
    url: https://repos.curseforge.com/wow/librangecheck-3-0/trunk/LibRangeCheck-3.0

ignore:
  - .github
  - tests
  - tools
  - STATUS.md
  - RELEASING.md
  - README.md
  - CHANGELOG.md

# Libraries are pulled at build time rather than committed, so the published
# package always ships their current upstream copies under their own licences.
# See THIRD-PARTY-NOTICES.md.
