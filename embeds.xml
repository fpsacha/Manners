	<!-- Last, and a bare Script rather than a lib.xml: the library is one file.
	     Two folders deep, because .pkgmeta checks out the library's whole
	     repository into Libs\LibRangeCheck-3.0 and the repository keeps the
	     file in a folder of the same name, beside its own tocs. One folder
	     shallower, which is the layout of the flat copy other addons carry,
	     names a file the packaged zip does not have, and the client skips a
	     missing file without a word. Nothing here depends on it having
	     loaded, since Core.lua asks LibStub with the silent flag, so a client
	     that skips this line loses the tighter distances and keeps everything
	     else. -->
	<Script file="Libs\LibRangeCheck-3.0\LibRangeCheck-3.0\LibRangeCheck-3.0.lua"/>
